{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "source": "macos",
        "padding": {
            "right": 4
        },
        "color": {
            "1": "#b58900",
            "2": "#b58900",
            "3": "#dc322f",
            "4": "#d33682",
            "5": "#268bd2"
        }
    },
    "display": {
        "separator": " ->     ",
        "color": {
            "keys": "#b58900",
            "title": "#657b83",
            "output": "#657b83",
            "separator": "#657b83"
        },
        "key": {
            "width": 17
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name} @ {host-name}"
        },
        {
            "type": "os",
            "key": "os      ",
            "format": "{name} {codename}"
        },
        {
            "type": "shell",
            "key": "shell   ",
            "format": "{pretty-name}"
        },
        {
            "type": "terminal",
            "key": "terminal",
            "format": "{pretty-name}"
        },
        {
            "type": "battery",
            "key": "battery ",
            "format": "{capacity}",
            "outputColor": "#859900"
        },
        {
            "type": "cpu",
            "key": "cpu     ",
            "format": "{name}"
        },
        {
            "type": "display",
            "key": "display ",
            "format": "{width}x{height} @ {refresh-rate} hz"
        }
    ]
}
